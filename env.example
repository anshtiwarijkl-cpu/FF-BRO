NODE_ENV=development
PORT=3000
TRUST_PROXY=1
SESSION_TTL_MS=28800000
HEALTH_TIMEOUT_MS=5000
HEALTH_INTERVAL_MS=5000
TOTP_ISSUER=ScannerAPI

# Admin login. Prefer ADMIN_PASSWORD_HASH in production.
ADMIN_USERNAME=ANSHAFT127987
ADMIN_PASSWORD=CHANGE_THIS_NOW
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$BASE64_SALT$HEX_DERIVED_KEY

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# MongoDB
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=scannerapi

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=scannerapi
MYSQL_PASSWORD=CHANGE_THIS
MYSQL_DATABASE=scannerapi
MYSQL_SSL=false

# Redis
REDIS_URL=redis://default:CHANGE_THIS@127.0.0.1:6379
REDIS_ACTIVITY_PREFIX=scannerapi:activity:
